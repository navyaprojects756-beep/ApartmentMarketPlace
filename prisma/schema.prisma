generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  CUSTOMER
  APARTMENT_SELLER
  OUTSIDE_SELLER
  DELIVERY_BOY
  GLOBAL_ADMIN
}

enum SellerType {
  APARTMENT
  OUTSIDE
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum HomeSellerDisplayMode {
  LOCAL_ONLY
  OUTSIDE_ONLY
  BOTH
}

enum AdvertisementType {
  PROMOTION
  SELLER_ADVERTISEMENT
  USER_ADVERTISEMENT
  PRODUCT_PROMOTION
  APARTMENT_ANNOUNCEMENT
  EVENT
  IMPORTANT_ALERT
}

enum AdvertisementStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY_FOR_PICKUP
  ASSIGNED_TO_DELIVERY_BOY
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  DUMMY_PAYMENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InventoryMovementType {
  INITIAL_STOCK
  SALE
  MANUAL_ADD
  MANUAL_REMOVE
  RETURN
  CANCELLED_ORDER
  ADJUSTMENT
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_PREPARING
  ORDER_READY
  DELIVERY_ASSIGNED
  ORDER_PICKED_UP
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ADVERTISEMENT
  IMPORTANT_ALERT
  SYSTEM
}

model User {
  id                String                 @id @default(uuid()) @db.Uuid
  phone             String                 @unique @db.VarChar(20)
  name              String?                @db.VarChar(120)
  email             String?                @unique @db.VarChar(255)
  profileImageUrl   String?                @map("profile_image_url") @db.Text
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  roles             UserRole[]
  refreshTokens     RefreshToken[]
  otpRequests       OtpRequest[]
  apartments        UserApartment[]
  sellerProfile     SellerProfile?
  deliveryBoy       DeliveryBoy?
  advertisements    Advertisement[]        @relation("AdvertisementRequester")
  advertisementReqs AdvertisementRequest[] @relation("AdvertisementRequestRequester")
  notifications     Notification[]         @relation("NotificationRecipient")
  notificationReads NotificationRead[]
  carts             Cart[]
  orders            Order[]                @relation("CustomerOrders")
  addresses         Address[]
  reviews           Review[]
  auditLogs         AuditLog[]             @relation("AuditActor")
  createdSettings   PlatformSetting[]      @relation("SettingCreator")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        RoleCode   @unique
  name        String     @db.VarChar(80)
  description String?    @db.Text
  users       UserRole[]
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model OtpRequest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash") @db.Text
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([userId])
  @@map("otp_requests")
}

model Apartment {
  id                 String                                @id @default(uuid()) @db.Uuid
  name               String                                @db.VarChar(160)
  address            String?                               @db.Text
  city               String?                               @db.VarChar(100)
  state              String?                               @db.VarChar(100)
  pincode            String?                               @db.VarChar(20)
  hasBlocks          Boolean                               @default(false) @map("has_blocks")
  hasPredefinedFlats Boolean                               @default(false) @map("has_predefined_flats")
  isActive           Boolean                               @default(true) @map("is_active")
  createdAt          DateTime                              @default(now()) @map("created_at")
  updatedAt          DateTime                              @updatedAt @map("updated_at")
  blocks             Block[]
  flats              Flat[]
  residents          UserApartment[]
  apartmentSellers   SellerProfile[]                       @relation("ApartmentSellerCommunity")
  deliveryAreas      SellerDeliveryArea[]
  deliveryBoyAreas   DeliveryBoyApartment[]
  adTargets          AdvertisementTargetApartment[]
  adRequestTargets   AdvertisementRequestTargetApartment[]
  orders             Order[]
  addresses          Address[]

  @@index([city, state])
  @@map("apartments")
}

model Block {
  id          String          @id @default(uuid()) @db.Uuid
  apartmentId String          @map("apartment_id") @db.Uuid
  name        String          @db.VarChar(80)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  apartment   Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  flats       Flat[]
  residents   UserApartment[]
  orders      Order[]
  addresses   Address[]

  @@unique([apartmentId, name])
  @@index([apartmentId])
  @@map("blocks")
}

model Flat {
  id          String          @id @default(uuid()) @db.Uuid
  apartmentId String          @map("apartment_id") @db.Uuid
  blockId     String?         @map("block_id") @db.Uuid
  number      String          @db.VarChar(40)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  apartment   Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  block       Block?          @relation(fields: [blockId], references: [id], onDelete: SetNull)
  residents   UserApartment[]
  orders      Order[]
  addresses   Address[]

  @@unique([apartmentId, blockId, number])
  @@index([apartmentId, blockId])
  @@map("flats")
}

model UserApartment {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  apartmentId      String    @map("apartment_id") @db.Uuid
  blockId          String?   @map("block_id") @db.Uuid
  flatId           String?   @map("flat_id") @db.Uuid
  manualFlatNumber String?   @map("manual_flat_number") @db.VarChar(40)
  isPrimary        Boolean   @default(false) @map("is_primary")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment        Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  block            Block?    @relation(fields: [blockId], references: [id], onDelete: SetNull)
  flat             Flat?     @relation(fields: [flatId], references: [id], onDelete: SetNull)

  @@unique([userId, apartmentId])
  @@index([apartmentId])
  @@map("user_apartments")
}

model SellerProfile {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @unique @map("user_id") @db.Uuid
  sellerType         SellerType             @map("seller_type")
  status             SellerStatus           @default(PENDING)
  sellerName         String                 @map("seller_name") @db.VarChar(160)
  businessName       String?                @map("business_name") @db.VarChar(160)
  email              String?                @db.VarChar(255)
  description        String?                @db.Text
  logoUrl            String?                @map("logo_url") @db.Text
  bannerUrl          String?                @map("banner_url") @db.Text
  address            String?                @db.Text
  apartmentId        String?                @map("apartment_id") @db.Uuid
  operatingHoursJson Json?                  @map("operating_hours_json")
  isOpen             Boolean                @default(false) @map("is_open")
  deliveryEnabled    Boolean                @default(true) @map("delivery_enabled")
  pickupEnabled      Boolean                @default(false) @map("pickup_enabled")
  minimumOrder       Decimal?               @map("minimum_order") @db.Decimal(12, 2)
  deliveryCharge     Decimal?               @map("delivery_charge") @db.Decimal(12, 2)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment          Apartment?             @relation("ApartmentSellerCommunity", fields: [apartmentId], references: [id], onDelete: SetNull)
  deliveryAreas      SellerDeliveryArea[]
  categories         SellerCategory[]
  products           Product[]
  advertisements     Advertisement[]
  advertisementReqs  AdvertisementRequest[]
  deliveryBoyLinks   DeliveryBoySeller[]
  carts              Cart[]
  orders             Order[]
  reviews            Review[]
  operatingHours     SellerOperatingHour[]

  @@index([sellerType, status])
  @@index([apartmentId])
  @@map("seller_profiles")
}

model SellerDeliveryArea {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @map("seller_id") @db.Uuid
  apartmentId String        @map("apartment_id") @db.Uuid
  isApproved  Boolean       @default(false) @map("is_approved")
  createdAt   DateTime      @default(now()) @map("created_at")
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  apartment   Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([sellerId, apartmentId])
  @@index([apartmentId, isApproved])
  @@map("seller_delivery_areas")
}

model SellerCategory {
  id        String        @id @default(uuid()) @db.Uuid
  sellerId  String        @map("seller_id") @db.Uuid
  name      String        @db.VarChar(100)
  imageUrl  String?       @map("image_url") @db.Text
  sortOrder Int           @default(0) @map("sort_order")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([sellerId, name])
  @@index([sellerId, isActive])
  @@map("seller_categories")
}

model Product {
  id                 String                       @id @default(uuid()) @db.Uuid
  sellerId           String                       @map("seller_id") @db.Uuid
  categoryId         String?                      @map("category_id") @db.Uuid
  name               String                       @db.VarChar(180)
  description        String?                      @db.Text
  sku                String?                      @db.VarChar(80)
  price              Decimal                      @db.Decimal(12, 2)
  discount           Decimal                      @default(0) @db.Decimal(12, 2)
  finalPrice         Decimal                      @map("final_price") @db.Decimal(12, 2)
  unit               String?                      @db.VarChar(40)
  inventoryTracking  Boolean                      @default(false) @map("inventory_tracking")
  availability       Boolean                      @default(true)
  minimumQuantity    Int                          @default(1) @map("minimum_quantity")
  maximumQuantity    Int?                         @map("maximum_quantity")
  preparationTimeMin Int?                         @map("preparation_time_min")
  deliveryEligible   Boolean                      @default(true) @map("delivery_eligible")
  pickupEligible     Boolean                      @default(true) @map("pickup_eligible")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  seller             SellerProfile                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category           SellerCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  adTargets          AdvertisementTargetProduct[]

  @@index([sellerId, availability])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Inventory {
  id            String              @id @default(uuid()) @db.Uuid
  productId     String              @unique @map("product_id") @db.Uuid
  quantity      Int                 @default(0)
  lowStockLevel Int                 @default(0) @map("low_stock_level")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id          String                @id @default(uuid()) @db.Uuid
  productId   String                @map("product_id") @db.Uuid
  inventoryId String?               @map("inventory_id") @db.Uuid
  type        InventoryMovementType
  quantity    Int
  reason      String?               @db.Text
  orderId     String?               @map("order_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at")
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory   Inventory?            @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  order       Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

model DeliveryBoy {
  id           String                    @id @default(uuid()) @db.Uuid
  userId       String                    @unique @map("user_id") @db.Uuid
  profilePhoto String?                   @map("profile_photo") @db.Text
  isActive     Boolean                   @default(true) @map("is_active")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellers      DeliveryBoySeller[]
  apartments   DeliveryBoyApartment[]
  assignments  OrderDeliveryAssignment[]

  @@map("delivery_boys")
}

model DeliveryBoySeller {
  deliveryBoyId String        @map("delivery_boy_id") @db.Uuid
  sellerId      String        @map("seller_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  deliveryBoy   DeliveryBoy   @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([deliveryBoyId, sellerId])
  @@index([sellerId])
  @@map("delivery_boy_sellers")
}

model DeliveryBoyApartment {
  deliveryBoyId String      @map("delivery_boy_id") @db.Uuid
  apartmentId   String      @map("apartment_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  deliveryBoy   DeliveryBoy @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  apartment     Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@id([deliveryBoyId, apartmentId])
  @@index([apartmentId])
  @@map("delivery_boy_apartments")
}

model Advertisement {
  id             String                         @id @default(uuid()) @db.Uuid
  requesterId    String                         @map("requester_id") @db.Uuid
  sellerId       String?                        @map("seller_id") @db.Uuid
  title          String                         @db.VarChar(180)
  description    String?                        @db.Text
  imageUrl       String?                        @map("image_url") @db.Text
  imageUrls      Json?                          @map("image_urls")
  type           AdvertisementType
  status         AdvertisementStatus            @default(DRAFT)
  startAt        DateTime?                      @map("start_at")
  endAt          DateTime?                      @map("end_at")
  priority       Int                            @default(0)
  approvedById   String?                        @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?                      @map("approved_at")
  adminRemarks   String?                        @map("admin_remarks") @db.Text
  createdAt      DateTime                       @default(now()) @map("created_at")
  updatedAt      DateTime                       @updatedAt @map("updated_at")
  requester      User                           @relation("AdvertisementRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  seller         SellerProfile?                 @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  targets        AdvertisementTargetApartment[]
  productTargets AdvertisementTargetProduct[]

  @@index([status, startAt, endAt])
  @@index([sellerId])
  @@map("advertisements")
}

model AdvertisementTargetApartment {
  advertisementId String        @map("advertisement_id") @db.Uuid
  apartmentId     String        @map("apartment_id") @db.Uuid
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  apartment       Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@id([advertisementId, apartmentId])
  @@index([apartmentId])
  @@map("advertisement_target_apartments")
}

model AdvertisementTargetProduct {
  advertisementId String        @map("advertisement_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([advertisementId, productId])
  @@map("advertisement_target_products")
}

model AdvertisementRequest {
  id           String                                @id @default(uuid()) @db.Uuid
  requesterId  String                                @map("requester_id") @db.Uuid
  sellerId     String?                               @map("seller_id") @db.Uuid
  title        String                                @db.VarChar(180)
  description  String?                               @db.Text
  imageUrl     String?                               @map("image_url") @db.Text
  imageUrls    Json?                                 @map("image_urls")
  type         AdvertisementType
  status       AdvertisementStatus                   @default(PENDING)
  startAt      DateTime?                             @map("start_at")
  endAt        DateTime?                             @map("end_at")
  priority     Int                                   @default(0)
  adminRemarks String?                               @map("admin_remarks") @db.Text
  reviewedById String?                               @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?                             @map("reviewed_at")
  createdAt    DateTime                              @default(now()) @map("created_at")
  updatedAt    DateTime                              @updatedAt @map("updated_at")
  requester    User                                  @relation("AdvertisementRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  seller       SellerProfile?                        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  targets      AdvertisementRequestTargetApartment[]

  @@index([status, startAt, endAt])
  @@map("advertisement_requests")
}

model AdvertisementRequestTargetApartment {
  advertisementRequestId String               @map("advertisement_request_id") @db.Uuid
  apartmentId            String               @map("apartment_id") @db.Uuid
  advertisementRequest   AdvertisementRequest @relation(fields: [advertisementRequestId], references: [id], onDelete: Cascade)
  apartment              Apartment            @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@id([advertisementRequestId, apartmentId])
  @@index([apartmentId])
  @@map("advertisement_request_target_apartments")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      NotificationType
  title     String             @db.VarChar(180)
  message   String             @db.Text
  data      Json?
  createdAt DateTime           @default(now()) @map("created_at")
  user      User               @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  reads     NotificationRead[]

  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationRead {
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at")
  dismissedAt    DateTime?    @map("dismissed_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("notification_reads")
}

model Cart {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  sellerId  String        @map("seller_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId, sellerId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                 String                   @id @default(uuid()) @db.Uuid
  orderNumber        String                   @unique @map("order_number") @db.VarChar(40)
  customerId         String                   @map("customer_id") @db.Uuid
  sellerId           String                   @map("seller_id") @db.Uuid
  apartmentId        String                   @map("apartment_id") @db.Uuid
  blockId            String?                  @map("block_id") @db.Uuid
  flatId             String?                  @map("flat_id") @db.Uuid
  addressId          String?                  @map("address_id") @db.Uuid
  subtotal           Decimal                  @db.Decimal(12, 2)
  discount           Decimal                  @default(0) @db.Decimal(12, 2)
  deliveryCharge     Decimal                  @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  total              Decimal                  @db.Decimal(12, 2)
  paymentMethod      PaymentMethod            @map("payment_method")
  paymentStatus      PaymentStatus            @default(PENDING) @map("payment_status")
  fulfillmentType    FulfillmentType          @map("fulfillment_type")
  status             OrderStatus              @default(PENDING)
  customerNotes      String?                  @map("customer_notes") @db.Text
  sellerNotes        String?                  @map("seller_notes") @db.Text
  acceptedAt         DateTime?                @map("accepted_at")
  preparingAt        DateTime?                @map("preparing_at")
  readyAt            DateTime?                @map("ready_at")
  pickedUpAt         DateTime?                @map("picked_up_at")
  deliveredAt        DateTime?                @map("delivered_at")
  cancelledAt        DateTime?                @map("cancelled_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  customer           User                     @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  seller             SellerProfile            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  apartment          Apartment                @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  block              Block?                   @relation(fields: [blockId], references: [id], onDelete: SetNull)
  flat               Flat?                    @relation(fields: [flatId], references: [id], onDelete: SetNull)
  address            Address?                 @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  deliveryAssignment OrderDeliveryAssignment?
  payment            Payment?
  reviews            Review[]
  inventoryMovements InventoryMovement[]

  @@index([customerId, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([apartmentId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name") @db.VarChar(180)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by_id") @db.Uuid
  note        String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderDeliveryAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @unique @map("order_id") @db.Uuid
  deliveryBoyId String      @map("delivery_boy_id") @db.Uuid
  assignedAt    DateTime    @default(now()) @map("assigned_at")
  pickedUpAt    DateTime?   @map("picked_up_at")
  deliveredAt   DateTime?   @map("delivered_at")
  note          String?     @db.Text
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryBoy   DeliveryBoy @relation(fields: [deliveryBoyId], references: [id], onDelete: Restrict)

  @@index([deliveryBoyId, assignedAt])
  @@map("order_delivery_assignments")
}

model Address {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  apartmentId      String    @map("apartment_id") @db.Uuid
  blockId          String?   @map("block_id") @db.Uuid
  flatId           String?   @map("flat_id") @db.Uuid
  manualFlatNumber String?   @map("manual_flat_number") @db.VarChar(40)
  label            String?   @db.VarChar(80)
  addressLine      String?   @map("address_line") @db.Text
  isDefault        Boolean   @default(false) @map("is_default")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment        Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  block            Block?    @relation(fields: [blockId], references: [id], onDelete: SetNull)
  flat             Flat?     @relation(fields: [flatId], references: [id], onDelete: SetNull)
  orders           Order[]

  @@index([userId])
  @@map("addresses")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @unique @map("order_id") @db.Uuid
  method        PaymentMethod
  status        PaymentStatus
  amount        Decimal       @db.Decimal(12, 2)
  transactionId String?       @map("transaction_id") @db.VarChar(120)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model Review {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  sellerId  String        @map("seller_id") @db.Uuid
  productId String?       @map("product_id") @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  rating    Int
  text      String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  product   Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, orderId, productId])
  @@index([sellerId, createdAt])
  @@map("reviews")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  value       String   @db.Text
  description String?  @db.Text
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   User?    @relation("SettingCreator", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  enabled     Boolean  @default(false)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model SellerOperatingHour {
  id        String        @id @default(uuid()) @db.Uuid
  sellerId  String        @map("seller_id") @db.Uuid
  dayOfWeek Int           @map("day_of_week")
  openTime  String?       @map("open_time") @db.VarChar(10)
  closeTime String?       @map("close_time") @db.VarChar(10)
  isClosed  Boolean       @default(false) @map("is_closed")
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, dayOfWeek])
  @@map("seller_operating_hours")
}
