{
  "expo": {
    "name": "GatedCart",
    "owner": "www.cheritech.com",
    "slug": "gatedcart-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gatedcart",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gatedcart.marketplace"
    },
    "android": {
      "package": "com.gatedcart.marketplace",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#ff6b00"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#fff9ef",
          "imageWidth": 330
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1bcf10f-eeb8-4ad1-9a42-070b7da16cf6"
      }
    }
  }
}
