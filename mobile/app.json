{
  "expo": {
    "name": "Nivasa Marketplace",
    "slug": "nivasa-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nivasa",
    "icon": "./assets/icon.svg",
    "splash": { "image": "./assets/splash.svg", "resizeMode": "contain", "backgroundColor": "#6d4aff" },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nivasa.marketplace"
    },
    "android": {
      "package": "com.nivasa.marketplace",
      "adaptiveIcon": {
        "backgroundColor": "#6d4aff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
