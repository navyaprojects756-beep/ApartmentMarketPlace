{
  "cli": { "version": ">= 10.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_WEB_APP_URL": "https://gatedcart.cheritech.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_WEB_APP_URL": "https://gatedcart.cheritech.com" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" },
      "ios": {}
    }
  }
}
